+# --- kv_len distribution probe (SGLANG_MLA_KVLEN_STATS=1) -------------------
+# The decode kernel's cost is set by the LONGEST sequence in the batch, not by
+# the total KV (measured: +71 % for 2x the max at constant total, -4 % for half
+# the total at constant max). The size of a straggler-aware rewrite is therefore
+# (max - mean) / max, and nothing in the trace or the server log carries it.
+#
+# `kv_indptr` is built INSIDE the cuda graph, so no host code sees its values on
+# a replayed step. These reductions are pure device ops with no host sync, so
+# they are capture-safe: they record into a device buffer that the scheduler
+# reads from outside the graph. All 61 layers overwrite the same slot, which is
+# fine -- they share the batch, so any one of them answers the question.
+#
+# Cost control: recording in all 61 layers costs 14 % per call (measured:
+# 345.6 -> 394.4 us at T=98, kv_len=708), which is far too much to fold into an
+# arm we intend to take timings from. But Python only runs at CAPTURE time, so
+# emitting the ops in ONE layer per forward puts ~7 extra tiny kernels in the
+# replayed graph instead of 427 -- 0.07 % of a 74 ms step. `_EMIT_EVERY`
+# defaults to the layer count, so the modulo lands on one layer per forward.
+_KVLEN_STATS = None
+_KVLEN_STATS_ON = os.environ.get("SGLANG_MLA_KVLEN_STATS", "0") == "1"
+# Default 1: record EVERY layer. This probe does not measure time -- the ~14 %
+# per-call cost of the reductions is irrelevant to it, and per-layer coverage
+# is not. Set it to the layer count if you ever need the probe on a timing arm.
+_KVLEN_EMIT_EVERY = int(os.environ.get("SGLANG_MLA_KVLEN_EVERY", "1"))
+_KVLEN_SLOTS = 80
+_KVLEN_CALL_CT = 0
+
+
+def kvlen_stats_buffer():
+    """-> the [mean, max, min, T] device tensor, or None if never recorded."""
+    return _KVLEN_STATS
+
+
+def _record_kvlen_stats(kv_indptr):
+    global _KVLEN_STATS, _KVLEN_CALL_CT
+    emit = _KVLEN_CALL_CT % _KVLEN_EMIT_EVERY == 0
+    _KVLEN_CALL_CT += 1
+    if not emit:
+        return
+    if _KVLEN_STATS is None:
+        # Allocate only on an EAGER call. sglang runs warmup forwards before it
+        # captures, so this lands outside capture; allocating inside a captured
+        # region would tie the buffer to that graph's private pool.
+        if torch.cuda.is_current_stream_capturing():
+            return
+        _KVLEN_STATS = torch.zeros(_KVLEN_SLOTS, 5, dtype=torch.float32,
+                                   device=kv_indptr.device)
+    # One slot per layer. DSv4 decode runs three ragged index streams
+    # (SWA / CSA / HCA, sliding_window=128), so if layers differ in which stream
+    # they read, sampling a single layer biases the very ratio this probe
+    # exists to measure -- and capture freezes WHICH layer, so it never rotates.
+    # _KVLEN_SLOTS > layers-per-forward, so the layers of one captured graph get
+    # distinct slots. The index is a Python int resolved at capture time, so it
+    # is a static offset, not a host-to-device write.
+    slot = (_KVLEN_CALL_CT - 1) % _KVLEN_SLOTS
+    d = (kv_indptr[1:] - kv_indptr[:-1]).to(torch.float32)
+    # Every write below is device->device. Writing a HOST scalar here (an
+    # earlier version stored `d.numel()`) is a pageable H2D copy, which aborts
+    # capture with hipErrorStreamCaptureUnsupported. That bug cost one launch.
+    _KVLEN_STATS[slot, 0] = d.mean()
+    _KVLEN_STATS[slot, 1] = d.max()
+    _KVLEN_STATS[slot, 2] = d.min()
+    _KVLEN_STATS[slot, 3] = d.median()
+    _KVLEN_STATS[slot, 4] = torch.quantile(d, 0.99)
+
+
