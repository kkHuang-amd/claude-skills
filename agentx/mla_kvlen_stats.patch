+# --- kv_len distribution probe (SGLANG_MLA_KVLEN_STATS=1) -------------------
+# The decode kernel's cost is set by the LONGEST sequence in the batch, not by
+# the total KV (measured: +71 % for 2x the max at constant total, -4 % for half
+# the total at constant max). The size of a straggler-aware rewrite is therefore
+# (max - mean) / max, and nothing in the trace or the server log carries it.
+#
+# `kv_indptr` is built INSIDE the cuda graph, so no host code sees its values on
+# a replayed step. These reductions are pure device ops with no host sync, so
+# they are capture-safe: they record into a device buffer that the scheduler
+# reads from outside the graph. All 61 layers overwrite the same slot, which is
+# fine -- they share the batch, so any one of them answers the question.
+#
+# Cost control: recording in all 61 layers costs 14 % per call (measured:
+# 345.6 -> 394.4 us at T=98, kv_len=708), which is far too much to fold into an
+# arm we intend to take timings from. But Python only runs at CAPTURE time, so
+# emitting the ops in ONE layer per forward puts ~7 extra tiny kernels in the
+# replayed graph instead of 427 -- 0.07 % of a 74 ms step. `_EMIT_EVERY`
+# defaults to the layer count, so the modulo lands on one layer per forward.
+_KVLEN_STATS = None
+_KVLEN_STATS_ON = os.environ.get("SGLANG_MLA_KVLEN_STATS", "0") == "1"
+_KVLEN_EMIT_EVERY = int(os.environ.get("SGLANG_MLA_KVLEN_EVERY", "61"))
+_KVLEN_CALL_CT = 0
+
+
+def kvlen_stats_buffer():
+    """-> the [mean, max, min, T] device tensor, or None if never recorded."""
+    return _KVLEN_STATS
+
+
+def _record_kvlen_stats(kv_indptr):
+    global _KVLEN_STATS, _KVLEN_CALL_CT
+    emit = _KVLEN_CALL_CT % _KVLEN_EMIT_EVERY == 0
+    _KVLEN_CALL_CT += 1
+    if not emit:
+        return
+    if _KVLEN_STATS is None:
+        _KVLEN_STATS = torch.zeros(4, dtype=torch.float32, device=kv_indptr.device)
+    d = (kv_indptr[1:] - kv_indptr[:-1]).float()
+    _KVLEN_STATS[0] = d.mean()
+    _KVLEN_STATS[1] = d.max()
+    _KVLEN_STATS[2] = d.min()
+    _KVLEN_STATS[3] = d.numel()
+
+
