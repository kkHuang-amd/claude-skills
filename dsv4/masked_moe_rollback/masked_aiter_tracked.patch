+def build_moe_route_maps_guarded_module():
+    """Like build_moe_route_maps but BOUNDS-GUARDED: skips slots whose expert is
+    out of range (``e >= experts``) or whose per-expert slot overflows
+    (``slot >= max_m``). Required under cuda-graph capture, where the unguarded
+    kernel's OOB buffer stores fault instead of being silently dropped. Invalid /
+    overflow slots write nothing (caller pre-zeros topids_to_rows)."""
+
+    @flyc.kernel(name="moe_route_maps_guarded")
+    def route_maps_guarded_kernel(
+        topk_ids: fx.Tensor,  # (numel,) int32, expert id per route
+        atomic_buffer: fx.Tensor,  # (experts,) int32, init 0
+        topids_to_rows: fx.Tensor,  # (numel,) int32 out (pre-zeroed)
+        rows_to_tokens: fx.Tensor,  # (experts*max_m,) int32 out (pre-filled -1)
+        numel: Int32,
+        topk: Int32,
+        max_m: Int32,
+        experts: Int32,
+    ):
+        i32 = T.i32
+        route = ArithValue(fx.block_idx.x) * arith.constant(
+            BLOCK_THREADS, type=i32
+        ) + ArithValue(fx.thread_idx.x)
+        in_range = arith.cmpi(CmpIPredicate.ult, route, ArithValue(numel))
+        _if = scf.IfOp(in_range)
+        with ir.InsertionPoint(_if.then_block):
+            topk_rsrc = buffer_ops.create_buffer_resource(topk_ids, max_size=True)
+            c_rsrc = buffer_ops.create_buffer_resource(topids_to_rows, max_size=True)
+            a_rsrc = buffer_ops.create_buffer_resource(rows_to_tokens, max_size=True)
+
+            e = buffer_ops.buffer_load(topk_rsrc, route, vec_width=1, dtype=i32)
+            # guard: only real experts (e < experts) touch the atomic / stores.
+            e_ok = arith.cmpi(CmpIPredicate.slt, e, ArithValue(experts))
+            _ife = scf.IfOp(e_ok)
+            with ir.InsertionPoint(_ife.then_block):
+                base_idx = buffer_ops.extract_base_index(atomic_buffer, address_space=1)
+                e_idx = arith.index_cast(T.index, e)
+                addr = fx.Index(base_idx) + fx.Index(e_idx) * fx.Index(4)
+                ptr = buffer_ops.create_llvm_ptr(addr, address_space=1)
+                ptr = ptr._value if hasattr(ptr, "_value") else ptr
+                slot = llvm.AtomicRMWOp(
+                    llvm.AtomicBinOp.add,
+                    ptr,
+                    arith.constant(1, type=i32),
+                    llvm.AtomicOrdering.monotonic,
+                    syncscope="agent",
+                    alignment=4,
+                ).result
+                # guard: only store when slot < max_m (no overflow spill).
+                slot_ok = arith.cmpi(CmpIPredicate.slt, ArithValue(slot), ArithValue(max_m))
+                _ifs = scf.IfOp(slot_ok)
+                with ir.InsertionPoint(_ifs.then_block):
+                    row = ArithValue(slot) + ArithValue(e) * ArithValue(max_m)
+                    buffer_ops.buffer_store(row, c_rsrc, route)
+                    token = arith.divui(route, ArithValue(topk))
+                    buffer_ops.buffer_store(token, a_rsrc, row)
+                    scf.YieldOp([])
+                scf.YieldOp([])
+            scf.YieldOp([])
+
+    @flyc.jit
+    def launch_route_maps_guarded(
+        topk_ids: fx.Tensor,
+        atomic_buffer: fx.Tensor,
+        topids_to_rows: fx.Tensor,
+        rows_to_tokens: fx.Tensor,
+        numel: fx.Int32,
+        topk: fx.Int32,
+        max_m: fx.Int32,
+        experts: fx.Int32,
+        grid_blocks: fx.Int32,
+        stream: fx.Stream = fx.Stream(None),
+    ):
+        gx = arith.index_cast(T.index, grid_blocks)
+        route_maps_guarded_kernel(
+            topk_ids, atomic_buffer, topids_to_rows, rows_to_tokens,
+            numel, topk, max_m, experts,
+        ).launch(
+            grid=(gx, 1, 1),
+            block=(BLOCK_THREADS, 1, 1),
+            stream=stream,
+        )
+
+    return launch_route_maps_guarded
+
+
