+def _maybe_run_mori_masked(
+    runner_input: AiterRunnerInput,
+    quant_info: AiterMoeQuantInfo,
+    config: MoeRunnerConfig,
+    running_state: dict,
+) -> Optional[torch.Tensor]:
+    """Opt-in gfx950 masked (deep_gemm-style) MoE for the mori-EP decode path.
+
+    Default OFF: returns None unless ``SGLANG_MORI_MASKED_MOE=1`` (and a positive
+    per-expert cap ``SGLANG_MORI_MASKED_MAX_M``) so the standard path is untouched.
+
+    Consumes the flat mori recv buffer (already fp8-quantized) directly, skipping
+    moe_sorting AND the fp8->bf16->fp8 activation round-trip (§5f): the masked
+    aiter GEMM natively takes fp8 + per-1x32 e8m0 scale. Output is flat recv-order
+    ``[M, model_dim]`` (un-weighted) which mori ``combine`` reduces to tokens.
+
+    DSV4 quark w4a4 stores w13/w2 as ``shuffle_weight((16,16))`` + ``e8m0_shuffle``
+    scales -- exactly the masked entry's expected layout -- so weights pass through.
+
+    Requires the recv buffer to be expert-contiguous ("packed"): rows are grouped
+    by local expert with per-expert counts ``num_recv_tokens_per_expert``. NOTE:
+    unvalidated on a live server; enable only for A/B testing.
+    """
+    if not get_bool_env_var("SGLANG_MORI_MASKED_MOE", "false"):
+        return None
+    if not running_state.get("aiter_combine_is_mori"):
+        return None
+    if runner_input.quant_type != AiterQuantType.PER_1X32:
+        return None
+    if not _is_gfx950():
+        return None
+    max_m = get_int_env_var("SGLANG_MORI_MASKED_MAX_M", 0)
+    if max_m <= 0:
+        return None
+    if runner_input.num_local_tokens is None:
+        return None
+    if config.activation not in ("silu", "swiglu"):
+        return None
+    # DECODE ONLY: prefill per-expert counts far exceed any static max_m and would
+    # drop tokens. Fall through to the sorted path for extend/prefill batches.
+    try:
+        from sglang.srt.layers.dp_attention import get_is_extend_in_batch
+
+        if get_is_extend_in_batch():
+            return None
+    except Exception:
+        return None
+
+    try:
+        from aiter.ops.flydsl.grouped_moe_gfx950 import flydsl_masked_moe_gfx950_recv
+
+        recv_hidden = runner_input.hidden_states  # [M, K] or [M, K/2] (fp4x2)
+        # Supported recv activation formats:
+        #  - fp4x2 (mxfp4 decode dispatch, the WORKING default): per-1x32 e8m0 scale
+        #    -> masked a4w4, consumed DIRECTLY (no upscale/round-trip). PREFERRED.
+        #  - bf16 (global bf16 dispatch): masked does a single per-1x32 fp8 quant.
+        # (mori fp8 dispatch is per-1x128 -> incompatible with the masked a8w4
+        # per-1x32 kernel; falls through.)
+        _fp4x2 = getattr(torch, "float4_e2m1fn_x2", None)
+        if _fp4x2 is not None and recv_hidden.dtype == _fp4x2:
+            recv_scale = runner_input.a1_scale  # per-1x32 e8m0 from mxfp4 dispatch
+            if recv_scale is None:
+                return None
+        elif recv_hidden.dtype == torch.bfloat16:
+            recv_scale = None
+        else:
+            return None
+
+        M, K = recv_hidden.shape
+        w13 = quant_info.w13_weight
+        E = w13.shape[0]  # num LOCAL experts
+        inter_dim = w13.shape[1] // 2
+        # model_dim = true K (recv K is packed /2 for fp4x2)
+        model_dim = K * 2 if (_fp4x2 is not None and recv_hidden.dtype == _fp4x2) else K
+
+        # mori recv is token-major: recv_topk_ids [M, topk] are GLOBAL expert ids
+        # (§6c). Validity is per-(row,slot) via expert_mask (== shipping
+        # get_topk_valid_mask); local block = contiguous [base, base+E), so
+        # base = first local index in expert_mask. NO total_recv prefix gate.
+        expert_mask = quant_info.expert_mask
+        if expert_mask is None:
+            return None
+        # graph-safe: keep base/total_recv as 0-d DEVICE tensors (NO .item() host
+        # sync) so the masked path is cuda-graph-capturable. The routing ops
+        # downstream consume them as tensors.
+        base = torch.argmax(expert_mask.to(torch.int32))  # 0-d int64 tensor
+        # valid recv rows are the prefix [0, total_recv); total_recv = sum of
+        # num_recv_tokens_per_expert (§6c-viii). Rows beyond are padding.
+        _nlt = runner_input.num_local_tokens
+        if not torch.is_tensor(_nlt):
+            _nlt = torch.tensor(list(_nlt), device=recv_hidden.device)
+        total_recv = _nlt.reshape(-1).sum()  # 0-d int tensor (on device)
+
+        _capturing = torch.cuda.is_current_stream_capturing()
+        if (
+            get_bool_env_var("SGLANG_MORI_MASKED_DEBUG", "false")
+            and not _capturing
+            and not getattr(_maybe_run_mori_masked, "_logged", False)
+        ):
+            print(
+                f"[mori-masked] ACTIVE: E={E} M={M} K={K} inter={inter_dim} "
+                f"max_m={max_m} base={int(base)} recv_dtype={recv_hidden.dtype}",
+                flush=True,
+            )
+            _maybe_run_mori_masked._logged = True
+
+        swiglu_limit = quant_info.swiglu_limit if quant_info.swiglu_limit > 0 else None
+        out = flydsl_masked_moe_gfx950_recv(
+            recv_hidden=recv_hidden,
+            recv_scale=recv_scale,
+            recv_topk_ids=runner_input.topk_ids,
+            recv_topk_weights=runner_input.topk_weights,
+            w1_shuf=w13,
+            w2_shuf=quant_info.w2_weight,
+            w1_scale_shuf=quant_info.w13_scale,
+            w2_scale_shuf=quant_info.w2_scale,
+            E=E,
+            expert_base=base,
+            total_recv=total_recv,
+            model_dim=model_dim,
+            inter_dim=inter_dim,
+            max_m=max_m,
+            activation=config.activation,
+            swiglu_limit=swiglu_limit,
+            # DSV4 default is gate_mode INTERLEAVE (GUGU) + a8w4 (fp8 act): the
+            # fused_moe key shows q_dtype_a=fp8, kernel flydsl_moe1_..._gui.
+            gate_mode="interleave",
+        )
+        if runner_input.output_dtype is not None:
+            out = out.to(runner_input.output_dtype)
+
+        # Track WORST masked-vs-default diff on genuinely-REAL rows (weight>0 AND
+        # both masked & ref finite) across ALL decode calls, to catch divergent
+        # batches (not just an early lucky one). Ref computed every call (2x MoE ->
+        # slow; use for diagnosis only, not for a valid gsm8k score).
+        if get_bool_env_var("SGLANG_MORI_MASKED_DUMP", "false"):
+            try:
+                from aiter.fused_moe import fused_moe as _ref_fused_moe
+
+                ref = _ref_fused_moe(
+                    hidden_states=recv_hidden,
+                    w1=quant_info.w13_weight,
+                    w2=quant_info.w2_weight,
+                    topk_weight=runner_input.topk_weights,
+                    topk_ids=runner_input.topk_ids,
+                    quant_type=_aiter_quant_type(runner_input.quant_type),
+                    activation=_aiter_activation(config.activation),
+                    w1_scale=quant_info.w13_scale,
+                    w2_scale=quant_info.w2_scale,
+                    a1_scale=recv_scale,
+                    a2_scale=quant_info.a2_scale,
+                    expert_mask=quant_info.expert_mask,
+                    num_local_tokens=runner_input.num_local_tokens,
+                    dtype=runner_input.output_dtype,
+                )
+                of = out.float()
+                rf = ref.float()
+                tw = runner_input.topk_weights.float()
+                # "normal-real" rows: weight>0, both finite, and REF magnitude is
+                # in the normal MoE-output range (|ref|<10 => exclude padding rows
+                # where the DEFAULT emits ~3e38 garbage). This isolates the rows
+                # that actually matter (what combine reads) from stale padding.
+                wpos = tw.sum(dim=1) > 0
+                fin = torch.isfinite(of).all(dim=1) & torch.isfinite(rf).all(dim=1)
+                refmag = rf.abs().amax(dim=1)
+                normal = wpos & fin & (refmag < 10.0)
+                nnorm = int(normal.sum())
+                c = getattr(_maybe_run_mori_masked, "_c", 0) + 1
+                _maybe_run_mori_masked._c = c
+                if nnorm:
+                    rowmax = (of - rf).abs().amax(dim=1)
+                    nidx = normal.nonzero().flatten()
+                    nrm = rowmax[nidx]
+                    nmax = float(nrm.max())
+                    gnmax = max(getattr(_maybe_run_mori_masked, "_gnmax", 0.0), nmax)
+                    _maybe_run_mori_masked._gnmax = gnmax
+                    if (nmax > 0.2 and not getattr(_maybe_run_mori_masked, "_shown", False)):
+                        rowmax2 = (of - rf).abs().amax(dim=1)
+                        nidx2 = normal.nonzero().flatten()
+                        order2 = torch.argsort(rowmax2[nidx2], descending=True)
+                        print(f"[REALDIFF2] call#{c} nmax={nmax:.4f} worst normal rows:", flush=True)
+                        for j in order2[:4].tolist():
+                            r = int(nidx2[j])
+                            print(
+                                f"  row{r} d={float(rowmax2[r]):.4f} |ref|={float(refmag[r]):.3f} "
+                                f"masked={[round(x,4) for x in of[r,:5].tolist()]} "
+                                f"ref={[round(x,4) for x in rf[r,:5].tolist()]} "
+                                f"ids={runner_input.topk_ids[r].tolist()} "
+                                f"w={[round(x,3) for x in tw[r].tolist()]}",
+                                flush=True,
+                            )
+                        _maybe_run_mori_masked._shown = True
+            except Exception as _e:
+                print(f"[mori-masked REALDIFF] failed: {_e}", flush=True)
+
+        return out
+    except Exception as exc:
+        if get_bool_env_var("SGLANG_MORI_MASKED_DEBUG", "false"):
+            import traceback
+
+            print(f"[mori-masked] fell back to default: {exc}", flush=True)
+            traceback.print_exc()
+        return None
+
