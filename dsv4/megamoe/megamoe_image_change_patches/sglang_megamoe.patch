+inline int getSMVersion(int device_id) {
+  int sm_major = 0;
+  int sm_minor = 0;
+#if defined(USE_ROCM) || defined(__HIP_PLATFORM_AMD__)
+  // ROCm/HIP: cuda* device-attr APIs/enums are not shimmed in this JIT include
+  // context; use the HIP equivalents directly.
+  hipDeviceGetAttribute(&sm_major, hipDeviceAttributeComputeCapabilityMajor, device_id);
+  hipDeviceGetAttribute(&sm_minor, hipDeviceAttributeComputeCapabilityMinor, device_id);
+#else
+  RuntimeDeviceCheck(cudaDeviceGetAttribute(&sm_major, cudaDevAttrComputeCapabilityMajor, device_id));
+  RuntimeDeviceCheck(cudaDeviceGetAttribute(&sm_minor, cudaDevAttrComputeCapabilityMinor, device_id));
+#endif
+  return sm_major * 10 + sm_minor;
+}
