+"""The OPUS sparse-prefill path must match the served aiter_sparse decode kernel on the packed fp8 KV:
+same keys (exact bf16 dequant into a request-local workspace), same top-k and SWA sets, per compress ratio."""
+
+import unittest
+
+import torch
+
+from sglang.srt.utils import is_gfx95_supported, is_hip
+from sglang.test.ci.ci_register import register_amd_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_amd_ci(est_time=60, suite="stage-b-kernel-test-1-gpu-amd-mi35x")
+
+NOPE, ROPE, D = 448, 64, 512
+PAGE = 256
+BYTES = 584
+H = 16
+SCALE = D**-0.5
+TOPK, SWA = 512, 128
+
+
+def _pack_cache(slots, device, gen):
+    """Random keys in the packed fp8 page layout [num_blocks, PAGE, 1, 584] (see test_hip_flash_mla_aiter_sparse)."""
+    num_blocks = (slots + PAGE - 1) // PAGE
+    slots = num_blocks * PAGE
+    k = torch.randn(slots, D, generator=gen) * 0.5
+    nope = k[:, :NOPE].reshape(slots, NOPE // 64, 64)
+    amax = nope.abs().amax(-1, keepdim=True).clamp(min=1e-6)
+    exp = torch.ceil(torch.log2(amax / 448.0)).clamp(min=-127, max=127)
+    nope_fp8 = (nope / torch.pow(2.0, exp)).to(torch.float8_e4m3fn)
+    rope = k[:, NOPE:].to(torch.bfloat16)
+    raw = torch.zeros(num_blocks, PAGE * BYTES, dtype=torch.uint8)
+    data = raw[:, : PAGE * 576].view(num_blocks, PAGE, 576)
+    data[:, :, :NOPE] = nope_fp8.view(torch.uint8).reshape(num_blocks, PAGE, NOPE)
+    data[:, :, NOPE:] = rope.view(torch.uint8).reshape(num_blocks, PAGE, 2 * ROPE)
+    scales = raw[:, PAGE * 576 :].view(num_blocks, PAGE, 8)
+    scales[:, :, :7] = (exp.reshape(num_blocks, PAGE, 7) + 127).to(torch.uint8)
+    deq = torch.cat(
+        [(nope_fp8.float() * torch.pow(2.0, exp)).reshape(slots, NOPE), rope.float()], 1
+    )
+    return raw.view(num_blocks, PAGE, 1, BYTES).view(torch.float8_e4m3fn).to(device), deq
+
+
+def _case(ratio, reqs, dev, seed=0):
+    """reqs = [(prefix, extend)]; shuffled req_to_token, SWA mapping, compressed pool and per-token index sets
+    in both forms: global slots (served path) and request-local raw positions (OPUS path)."""
+    gen = torch.Generator().manual_seed(seed)
+    n_full = 32768
+    max_len = max(p + e for p, e in reqs)
+    perm = torch.randperm(n_full, generator=gen)
+    req_to_token = torch.zeros(len(reqs) + 1, max_len, dtype=torch.int32)
+    for b, (p, e) in enumerate(reqs):
+        req_to_token[b + 1, : p + e] = perm[b * max_len : b * max_len + p + e].to(torch.int32)
+    full_to_swa = torch.randperm(n_full, generator=gen).to(torch.int32)
+    swa_cache, swa_deq = _pack_cache(n_full, dev, gen)
+    c_cache, c_deq = _pack_cache(n_full // max(ratio, 1) + 1, dev, gen)
+    req_pool = torch.arange(1, len(reqs) + 1)
+    positions, swa_idx, raw, c_idx, raw_lens = [], [], [], [], []
+    for b, (p, e) in enumerate(reqs):
+        for pos in range(p, p + e):
+            positions.append(pos)
+            n_swa = min(pos + 1, SWA)
+            s = [int(full_to_swa[req_to_token[b + 1, pos - i]]) for i in range(n_swa)]
+            swa_idx.append(s + [-1] * (SWA - n_swa))
+            if ratio:
+                lc = (pos + 1) // ratio
+                n = min(lc, TOPK)
+                j = torch.sort(torch.randperm(lc, generator=gen)[:n]).values.tolist() if lc else []
+                raw.append(j + [-1] * (TOPK - n))
+                c_idx.append([int(req_to_token[b + 1, x * ratio]) // ratio for x in j] + [-1] * (TOPK - n))
+                raw_lens.append(max(n, 1))
+    t = lambda x: torch.tensor(x, dtype=torch.int32, device=dev)  # noqa: E731
+    T = len(positions)
+    return dict(
+        req_to_token=req_to_token.to(dev),
+        full_to_swa=full_to_swa.to(dev),
+        req_pool=req_pool.to(dev),
+        seq_lens=[p + e for p, e in reqs],
+        ext_lens=[e for _, e in reqs],
+        positions=torch.tensor(positions, dtype=torch.int64, device=dev),
+        swa_cache=swa_cache,
+        c_cache=c_cache if ratio else None,
+        swa_idx=t(swa_idx).view(T, 1, SWA),
+        raw=t(raw) if ratio else None,
+        c_idx=t(c_idx).view(T, 1, TOPK) if ratio else None,
+        raw_lens=t(raw_lens) if ratio else None,
+        q=(torch.randn(T, H, D, generator=gen) * 0.5).to(torch.bfloat16).to(dev),
+        sink=(torch.randn(H, generator=gen) * 0.5).to(dev),
+    )
+
+
+@unittest.skipIf(not (is_hip() and is_gfx95_supported()), "gfx950 only")
+class TestOpusPrefill(CustomTestCase):
+    REQS = [(0, 1024), (300, 700), (5000, 1500)]
+
+    def _run(self, ratio):
+        from sglang.kernels.ops.attention.dsv4.opus_prefill_hip import (
+            OpusPrefillRows,
+            opus_sparse_prefill,
+        )
+        from sglang.srt.layers.attention.hip_flash_mla import aiter_sparse_decode_fwd
+
+        c = _case(ratio, self.REQS, torch.device("cuda"))
+        ref, _ = aiter_sparse_decode_fwd(
+            c["q"].unsqueeze(1),
+            c["swa_cache"],
+            c["swa_idx"],
+            c["sink"],
+            SCALE,
+            extra_k_cache=c["c_cache"],
+            extra_indices_in_kvcache=c["c_idx"],
+        )
+        plan = OpusPrefillRows(
+            req_to_token=c["req_to_token"],
+            full_to_swa=c["full_to_swa"],
+            req_pool_indices=c["req_pool"],
+            seq_lens_cpu=c["seq_lens"],
+            extend_lens_cpu=c["ext_lens"],
+            positions=c["positions"],
+        )
+        out = opus_sparse_prefill(
+            plan,
+            q=c["q"],
+            ratio=ratio,
+            swa_cache=c["swa_cache"],
+            extra_cache=c["c_cache"],
+            raw_indices=c["raw"],
+            raw_lens=c["raw_lens"],
+            attn_sink=c["sink"],
+            softmax_scale=SCALE,
+            check=True,
+        )
+        ref = ref.squeeze(1).float()
+        diff = (out.float() - ref).abs()
+        cos = torch.nn.functional.cosine_similarity(out.float().flatten(), ref.flatten(), dim=0)
+        print(f"ratio={ratio} T={out.shape[0]} max_abs={diff.max():.4g} mean_abs={diff.mean():.4g} cos={cos:.8f}")
+        self.assertTrue(torch.isfinite(out).all())
+        self.assertLess(float(1 - cos), 5e-5)
+        self.assertLess(float(diff.max()), 5e-2)
+
+    def test_ratio0_swa_only(self):
+        self._run(0)
+
+    def test_ratio1(self):
+        self._run(1)
+
+    def test_ratio2(self):
+        self._run(2)
+
+    def test_mixed_batch_with_decode_rows(self):
+        """A MIXED batch: prefill requests plus running requests extending by one token."""
+        self.REQS = [(0, 1024), (2000, 1), (300, 700), (777, 1), (5000, 1500), (129, 1)]
+        for ratio in (0, 1, 2):
+            self._run(ratio)
+
+
+if __name__ == "__main__":
+    unittest.main()
