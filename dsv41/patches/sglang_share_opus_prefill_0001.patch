+    def _opus_prefill_eligible(
+        self,
+        *,
+        q: torch.Tensor,
+        forward_batch: ForwardBatch,
+        compress_ratio: int,
+        swa_k_cache: torch.Tensor,
+        extra_k_cache: Optional[torch.Tensor],
+    ) -> bool:
+        if not envs.SGLANG_OPT_DSV41_OPUS_PREFILL.get():
+            return False
+        num_tokens = q.shape[0]
+        packed = KVLayout.V4.bytes_per_token
+        return (
+            # MIXED rows of running requests are extends of length 1 (mix_with_running)
+            forward_batch.forward_mode in (ForwardMode.EXTEND, ForwardMode.MIXED)
+            and compress_ratio in (0, 1, 2)
+            and bool(self.forward_metadata.core_attn_metadata.low_ratios)
+            and num_tokens >= envs.SGLANG_OPT_DSV41_OPUS_PREFILL_MIN_TOKENS.get()
+            and forward_batch.extend_seq_lens_cpu is not None
+            and num_tokens == sum(forward_batch.extend_seq_lens_cpu)
+            and num_tokens == forward_batch.positions.shape[0]
+            and q.dtype == torch.bfloat16
+            and q.shape[-1] == 512
+            and swa_k_cache.shape[-1] == packed
+            and (extra_k_cache is None or extra_k_cache.shape[-1] == packed)
+            and not is_cp_active(forward_batch)
+            and not self.enable_decoder_swa_bounded_replay
+            and not self.encoder_replay
+            and self.forward_metadata.late_layer_tail is None
+            and not torch.cuda.is_current_stream_capturing()
+            and is_gfx95_supported()
+            and get_opus() is not None
+        )
+
+    def _opus_prefill(
+        self,
+        *,
+        q: torch.Tensor,
+        layer: RadixAttention,
+        forward_batch: ForwardBatch,
+        compress_ratio: int,
+        swa_k_cache: torch.Tensor,
+        extra_k_cache: Optional[torch.Tensor],
+        extra_topk_lengths: Optional[torch.Tensor],
+        attn_sink: torch.Tensor,
+        inv_rope: Optional[Tuple[torch.Tensor, torch.Tensor]],
+    ) -> Optional[torch.Tensor]:
+        """OPUS sparse prefill for a plain V4.1 extend batch; None keeps the decode-kernel path."""
+        if not self._opus_prefill_eligible(
+            q=q,
+            forward_batch=forward_batch,
+            compress_ratio=compress_ratio,
+            swa_k_cache=swa_k_cache,
+            extra_k_cache=extra_k_cache,
+        ):
+            return None
+        num_tokens = q.shape[0]
+        raw = raw_lens = None
+        if compress_ratio:
+            raw = self.forward_metadata.core_attn_metadata.sparse_raw_indices(
+                compress_ratio
+            )
+            if raw is None or raw.shape[1] != 512 or extra_topk_lengths is None:
+                return None
+            raw = raw[:num_tokens]
+            raw_lens = extra_topk_lengths.reshape(-1)[:num_tokens].to(torch.int32)
+        if self._opus_rows is None:
+            logger.info("DSV4.1 extend attention: using aiter OPUS sparse prefill")
+        if self._opus_rows is None or layer.layer_id <= self._opus_last_layer_id:
+            self._opus_rows = OpusPrefillRows(
+                req_to_token=self.req_to_token,
+                full_to_swa=self.token_to_kv_pool.full_to_swa_index_mapping,
+                req_pool_indices=forward_batch.req_pool_indices,
+                seq_lens_cpu=[int(x) for x in forward_batch.seq_lens_cpu],
+                extend_lens_cpu=[int(x) for x in forward_batch.extend_seq_lens_cpu],
+                positions=forward_batch.positions,
+            )
+        self._opus_last_layer_id = layer.layer_id
+        plan = self._opus_rows
+        if plan.rows(compress_ratio) > envs.SGLANG_OPT_DSV41_OPUS_PREFILL_MAX_WS_ROWS.get():
+            return None
+        return opus_sparse_prefill(
+            plan,
+            q=q.reshape(num_tokens, q.shape[-2], q.shape[-1]),
+            ratio=compress_ratio,
+            swa_cache=swa_k_cache,
+            extra_cache=extra_k_cache,
+            raw_indices=raw,
+            raw_lens=raw_lens,
+            attn_sink=attn_sink,
+            softmax_scale=self.softmax_scale,
+            inv_rope=inv_rope,
+            check=envs.SGLANG_DEBUG_DSV41_OPUS_PREFILL_CHECK.get(),
+        )
+
