+"""DeepSeek-V4.1 sparse-attention prefill on gfx950 through aiter's OPUS kernel.
+
+The served HIP path attends prefill with the decode kernel (``pa_decode_sparse``) straight
+off the packed fp8 pages. OPUS (``pa_sparse_prefill_opus``) is ~2.4x faster at >= 1k query
+tokens but reads bf16 rows, so per forward we dequantize the rows the batch can reach into a
+request-local bf16 workspace and re-express every token's index lists as workspace rows:
+
+  workspace = [ compressed rows of req 0 .. req B-1 | SWA rows of req 0 .. req B-1 ]
+  compressed rows of req b: positions j in [0, seq_len_b // R), slot req_to_token[b, j*R] // R
+  SWA rows of req b:        positions p in [lo_b, seq_len_b),  slot full_to_swa[req_to_token[b, p]]
+
+The fp8 -> bf16 dequant is exact, so OPUS sees the same keys the decode kernel does. The slot
+lists are layer-invariant and built once per forward; each layer re-runs only the gather.
+"""
+
+from __future__ import annotations
+
+import functools
+import itertools
+from typing import List, Optional, Tuple
+
+import torch
+import triton
+import triton.language as tl
+
+NOPE = tl.constexpr(448)
+HEAD = tl.constexpr(512)
+ROW_BYTES = tl.constexpr(576)  # NoPE fp8 + RoPE bf16, per slot, in the page's data region
+SCALE_BYTES = tl.constexpr(8)  # 7 E8M0 exponents (one per 64 NoPE values) + 1 pad, trailing region
+BYTES_PER_TOKEN = 584
+SWA_WINDOW = tl.constexpr(128)
+
+
+@functools.cache
+def get_opus():
+    try:
+        from aiter.ops.pa_sparse_prefill_opus import pa_sparse_prefill_opus
+    except ImportError:
+        return None
+    return pa_sparse_prefill_opus
+
+
+@triton.jit
+def _dequant_gather_kernel(
+    cache_u8,
+    cache_i16,
+    page_stride,
+    src_slots,
+    out,
+    PAGE: tl.constexpr,
+):
+    r = tl.program_id(0)
+    s = tl.load(src_slots + r).to(tl.int64)
+    lane = tl.arange(0, HEAD)
+    is_nope = lane < NOPE
+    page = s // PAGE
+    off = s % PAGE
+    base = page * page_stride
+    ok = s >= 0
+    byte = tl.load(cache_u8 + base + off * ROW_BYTES + lane, mask=ok & is_nope, other=0)
+    exp = tl.load(
+        cache_u8 + base + PAGE * ROW_BYTES + off * SCALE_BYTES + lane // 64,
+        mask=ok & is_nope,
+        other=127,
+    )
+    nope = byte.to(tl.float8e4nv, bitcast=True).to(tl.float32) * tl.exp2(
+        exp.to(tl.float32) - 127.0
+    )
+    rope_i16 = tl.load(
+        cache_i16 + (base + off * ROW_BYTES + NOPE) // 2 + (lane - NOPE),
+        mask=ok & (lane >= NOPE),
+        other=0,
+    )
+    rope = rope_i16.to(tl.bfloat16, bitcast=True).to(tl.float32)
+    val = tl.where(is_nope, nope, rope)
+    val = tl.where(ok, val, 0.0)
+    tl.store(out + r.to(tl.int64) * HEAD + lane, val.to(tl.bfloat16))
+
+
+def dequant_gather(
+    cache: torch.Tensor, src_slots: torch.Tensor, out: torch.Tensor
+) -> torch.Tensor:
+    """Rows ``src_slots`` of a packed fp8 page cache ([pages, PAGE, 1, 584] view) as bf16 [n, 512]."""
+    pages, page_size = cache.shape[0], cache.shape[1]
+    assert cache.shape[-1] == BYTES_PER_TOKEN, cache.shape
+    u8 = cache.view(torch.uint8)
+    assert u8.stride(0) % 2 == 0 and u8.stride(1) == BYTES_PER_TOKEN, u8.stride()
+    flat = torch.as_strided(u8, (pages * u8.stride(0),), (1,), u8.storage_offset())
+    n = src_slots.numel()
+    if n:
+        _dequant_gather_kernel[(n,)](
+            flat, flat.view(torch.int16), u8.stride(0), src_slots, out, PAGE=page_size
+        )
+    return out
+
+
+@triton.jit
+def _csr_fill_kernel(
+    raw,
+    raw_stride,
+    raw_lens,
+    pos,
+    req,
+    cbase,
+    sbase,
+    lo,
+    indptr,
+    idx,
+    K: tl.constexpr,
+    HAS_C: tl.constexpr,
+):
+    t = tl.program_id(0)
+    p = tl.load(pos + t).to(tl.int32)
+    b = tl.load(req + t)
+    start = tl.load(indptr + t)
+    c = 0
+    if HAS_C:
+        k = tl.arange(0, K)
+        r = tl.load(raw + t.to(tl.int64) * raw_stride + k)
+        valid = (r >= 0) & (k < tl.load(raw_lens + t))
+        rank = tl.cumsum(valid.to(tl.int32), axis=0) - 1
+        tl.store(idx + start + rank, tl.load(cbase + b) + r, mask=valid)
+        c = tl.sum(valid.to(tl.int32), axis=0)
+    i = tl.arange(0, SWA_WINDOW)
+    n_swa = tl.minimum(p + 1, SWA_WINDOW)
+    first = tl.load(sbase + b) + (p - n_swa + 1 - tl.load(lo + b))
+    tl.store(idx + start + c + i, first + i, mask=i < n_swa)
+
+
+class OpusPrefillRows:
+    """Layer-invariant workspace plan for one forward (built once, reused by every layer)."""
+
+    def __init__(
+        self,
+        *,
+        req_to_token: torch.Tensor,
+        full_to_swa: torch.Tensor,
+        req_pool_indices: torch.Tensor,
+        seq_lens_cpu: List[int],
+        extend_lens_cpu: List[int],
+        positions: torch.Tensor,
+    ):
+        dev = positions.device
+        self.seq_lens_cpu, self.extend_lens_cpu = seq_lens_cpu, extend_lens_cpu
+        self.req_pool_indices = req_pool_indices.to(torch.int64)
+        self.req_to_token, self.dev = req_to_token, dev
+        self.positions = positions
+        self.num_tokens = sum(extend_lens_cpu)
+        b = len(seq_lens_cpu)
+        self.req_of_token = torch.repeat_interleave(
+            torch.arange(b, device=dev, dtype=torch.int32),
+            torch.tensor(extend_lens_cpu, device=dev),
+        )
+        # SWA rows: positions [lo_b, L_b)
+        lo = [max(L - E - (int(SWA_WINDOW) - 1), 0) for L, E in zip(seq_lens_cpu, extend_lens_cpu)]
+        swa_counts = [L - l for L, l in zip(seq_lens_cpu, lo)]
+        self.swa_rows = sum(swa_counts)
+        self._swa_lo = lo
+        self._swa_counts = swa_counts
+        rows = self._rows_of(lo, swa_counts)  # (req_row, position) pairs
+        tok = req_to_token[rows[0], rows[1]].to(torch.int64)
+        self.swa_src = full_to_swa[tok].to(torch.int32)
+        self.lo = torch.tensor(lo, device=dev, dtype=torch.int32)
+        self.n_swa = torch.clamp(positions.to(torch.int32) + 1, max=int(SWA_WINDOW))
+        self.no_extend_idx = torch.empty(0, dtype=torch.int32, device=dev)
+        self.no_extend_indptr = torch.zeros(self.num_tokens + 1, dtype=torch.int32, device=dev)
+        self._comp = {}
+        self._sbase = {}
+
+    def _rows_of(self, starts: List[int], counts: List[int]):
+        counts_t = torch.tensor(counts, device=self.dev, dtype=torch.int64)
+        req_rows = torch.repeat_interleave(self.req_pool_indices, counts_t)
+        seg = torch.tensor(
+            [0, *itertools.accumulate(counts)][:-1], device=self.dev, dtype=torch.int64
+        )
+        j = torch.arange(int(sum(counts)), device=self.dev) - torch.repeat_interleave(
+            seg, counts_t
+        )
+        return req_rows, j + torch.repeat_interleave(
+            torch.tensor(starts, device=self.dev, dtype=torch.int64), counts_t
+        )
+
+    def compressed(self, ratio: int) -> Tuple[torch.Tensor, int, torch.Tensor]:
+        """(src slots, row count, per-request base) of the ratio-R compressed rows."""
+        if ratio not in self._comp:
+            lc = [L // ratio for L in self.seq_lens_cpu]
+            req_rows, j = self._rows_of([0] * len(lc), lc)
+            src = (self.req_to_token[req_rows, j * ratio].to(torch.int64) // ratio).to(
+                torch.int32
+            )
+            cbase = torch.tensor(
+                [0, *itertools.accumulate(lc)][:-1], device=self.dev, dtype=torch.int32
+            )
+            self._comp[ratio] = (src, sum(lc), cbase)
+        return self._comp[ratio]
+
+    def rows(self, ratio: int) -> int:
+        return (self.compressed(ratio)[1] if ratio else 0) + self.swa_rows
+
+    def swa_base(self, ratio: int) -> torch.Tensor:
+        """Per-request first SWA row, after the ratio's compressed rows."""
+        if ratio not in self._sbase:
+            c_rows = self.compressed(ratio)[1] if ratio else 0
+            starts = [0, *itertools.accumulate(self._swa_counts)][:-1]
+            self._sbase[ratio] = torch.tensor(
+                [c_rows + x for x in starts], device=self.dev, dtype=torch.int32
+            )
+        return self._sbase[ratio]
+
+
+def opus_sparse_prefill(
+    plan: OpusPrefillRows,
+    *,
+    q: torch.Tensor,
+    ratio: int,
+    swa_cache: torch.Tensor,
+    extra_cache: Optional[torch.Tensor],
+    raw_indices: Optional[torch.Tensor],
+    raw_lens: Optional[torch.Tensor],
+    attn_sink: torch.Tensor,
+    softmax_scale: float,
+    inv_rope=None,
+    check: bool = False,
+) -> torch.Tensor:
+    """q [T, H, 512] bf16 -> out [T, H, 512] bf16 for one layer."""
+    from sglang.srt.layers.attention.hip_flash_mla import _apply_inverse_rope
+
+    opus = get_opus()
+    T = q.shape[0]
+    dev = q.device
+    has_c = ratio > 0
+    if has_c:
+        c_src, c_rows, cbase = plan.compressed(ratio)
+    else:
+        c_src, c_rows, cbase = None, 0, torch.zeros_like(plan.lo)
+    ws = torch.empty((c_rows + plan.swa_rows, int(HEAD)), dtype=torch.bfloat16, device=dev)
+    if has_c:
+        dequant_gather(extra_cache, c_src, ws[:c_rows])
+    dequant_gather(swa_cache, plan.swa_src, ws[c_rows:])
+    sbase = plan.swa_base(ratio)
+    n_swa = plan.n_swa
+    if has_c:
+        k = torch.arange(raw_indices.shape[1], device=dev)
+        n_c = ((raw_indices >= 0) & (k < raw_lens.unsqueeze(1))).sum(1, dtype=torch.int32)
+        counts = n_c + n_swa
+    else:
+        counts = n_swa
+    indptr = torch.zeros(T + 1, dtype=torch.int32, device=dev)
+    torch.cumsum(counts, 0, out=indptr[1:])
+    # upper bound instead of reading indptr[-1]: avoids a host sync per layer; OPUS reads only via indptr
+    k_max = raw_indices.shape[1] if has_c else 0
+    idx = torch.empty(T * (k_max + int(SWA_WINDOW)), dtype=torch.int32, device=dev)
+    _csr_fill_kernel[(T,)](
+        raw_indices if has_c else idx,
+        raw_indices.stride(0) if has_c else 0,
+        raw_lens if has_c else counts,
+        plan.positions,
+        plan.req_of_token,
+        cbase,
+        sbase,
+        plan.lo,
+        indptr,
+        idx,
+        K=raw_indices.shape[1] if has_c else 512,
+        HAS_C=has_c,
+    )
+    if check:
+        used = idx[: int(indptr[-1])]
+        assert int(used.min()) >= 0 and int(used.max()) < ws.shape[0], (
+            int(used.min()),
+            int(used.max()),
+            ws.shape,
+        )
+    out = opus(
+        q.contiguous(),
+        ws,
+        idx,
+        indptr,
+        ws[:1],
+        plan.no_extend_idx,
+        plan.no_extend_indptr,
+        attn_sink.float(),
+        softmax_scale,
+    )
+    if inv_rope is not None:
+        _apply_inverse_rope(out, inv_rope)
+    return out
