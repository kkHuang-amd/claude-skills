+++ b/benchmark/kernels/deepseek/benchmark_dsv4_topk_tdm_hist_gfx1250.py
@@ -0,0 +1,138 @@
+"""Benchmark the histogram/threshold phase of a gfx1250 TDM TopK cluster.
+
+This is an isolated development probe. It imports AITER's header-only Opus TDM
+descriptor implementation through an explicit include path; production SGLang
+integration must vendor the required descriptor subset or add a real dependency.
+"""
+
+import torch
+
+from sglang.kernels.jit.benchmark import marker
+from sglang.kernels.jit.utils import cache_once, load_jit
+
+TOPK = 512
+HIST_SIZE = 1024
+CLUSTER_SIZES = (2, 4, 8)
+BATCH_SIZES = (1, 2, 4, 8)
+C4_SEQ_LENS = (131072, 196608, 262144, 393216, 524288)
+WARMUP_ITERS = 20
+REPLAY_ITERS = 100
+
+
+@cache_once
+def load_probe(cluster_size: int):
+    return load_jit(
+        f"topk_tdm_hist_probe_gfx1250_c{cluster_size}",
+        cuda_files=["deepseek_v4/topk_tdm_hist_probe.cuh"],
+        cuda_wrappers=[
+            (
+                "streaming",
+                "sglang::topk_tdm_probe::TopKTdmHistProbe::streaming",
+            ),
+            (
+                "cluster_tdm",
+                "sglang::topk_tdm_probe::TopKTdmHistProbe::cluster_tdm",
+            ),
+            (
+                "full_cluster_tdm",
+                "sglang::topk_tdm_probe::TopKTdmHistProbe::full_cluster_tdm",
+            ),
+        ],
+        extra_cuda_cflags=[
+            "-DSGL_ROCM_ARCH_GFX1250=1",
+            f"-DTOPK_TDM_PROBE_CLUSTER_SIZE={cluster_size}",
+        ],
+        extra_include_paths=["/sgl-workspace/aiter/csrc/include"],
+    )
+
+
+def coarse_bin_10(values: torch.Tensor) -> torch.Tensor:
+    bits = values.half().view(torch.uint16).to(torch.int32)
+    key = torch.where(
+        (bits & 0x8000) != 0,
+        (~bits) & 0xFFFF,
+        bits | 0x8000,
+    )
+    return key >> 6
+
+
+def benchmark_shape(batch_size: int, seq_len: int, cluster_size: int):
+    torch.manual_seed(batch_size * 100_003 + seq_len)
+    scores = torch.randn(
+        batch_size, seq_len, dtype=torch.float32, device="cuda"
+    )
+    scratch = torch.empty(
+        batch_size,
+        cluster_size,
+        HIST_SIZE,
+        dtype=torch.int32,
+        device="cuda",
+    )
+    streaming_out = torch.empty(
+        batch_size, dtype=torch.int32, device="cuda"
+    )
+    cluster_out = torch.empty(
+        batch_size, cluster_size, dtype=torch.int32, device="cuda"
+    )
+    module = load_probe(cluster_size)
+
+    def streaming():
+        module.streaming(scores, streaming_out, TOPK)
+
+    def cluster_tdm():
+        module.cluster_tdm(scores, scratch, cluster_out, TOPK)
+
+    streaming()
+    cluster_tdm()
+    torch.cuda.synchronize()
+
+    kth_values = torch.topk(scores, TOPK, dim=1, sorted=False).values.min(dim=1).values
+    reference = coarse_bin_10(kth_values)
+    if not torch.equal(streaming_out, reference):
+        raise AssertionError("streaming threshold differs from torch.topk")
+    expected_cluster = reference[:, None].expand(-1, cluster_size)
+    if not torch.equal(cluster_out, expected_cluster):
+        raise AssertionError("TDM cluster thresholds differ from torch.topk")
+
+    common = {
+        "use_cuda_graph": False,
+        "warmup_iters": WARMUP_ITERS,
+        "replay_iters": REPLAY_ITERS,
+        "metrics": (0.5, "avg"),
+        "memory_args": (scores,),
+    }
+    streaming_times = marker.do_bench(streaming, **common).times
+    cluster_times = marker.do_bench(cluster_tdm, **common).times
+    return streaming_times, cluster_times
+
+
+def main():
+    props = torch.cuda.get_device_properties(torch.cuda.current_device())
+    print(f"device: {props.name} ({getattr(props, 'gcnArchName', 'unknown')})")
+    print(
+        f"correctness: threshold bin versus torch.topk; "
+        f"timing: {WARMUP_ITERS} warmups, {REPLAY_ITERS} GPU-event iterations"
+    )
+    print(
+        "| cluster | batch | C4 seq | streaming median us | TDM cluster median us | "
+        "streaming avg us | TDM cluster avg us | speedup |"
+    )
