@@ -0,0 +1,160 @@
+"""Benchmark a full gfx1250 TDM-cluster TopK prototype against v2 streaming.
+
+This is retained research code, not a production candidate. The measured full
+kernel was slower than v2 streaming at every DeepSeek-V4-Flash-valid shape.
+"""
+
+import torch
+
+from sglang.kernels.jit.benchmark import marker
+from sglang.kernels.jit.utils import cache_once, load_jit
+from sglang.kernels.ops.attention.dsv4.topk import (
+    plan_topk_v2,
+    topk_transform_512_v2,
+)
+
+TOPK = 512
+PAGE_SIZE = 64
+HIST_SIZE = 1024
+MAX_TIES = 2048
+CLUSTER_SIZES = (2, 4)
+BATCH_SIZES = (1, 2, 4)
+C4_SEQ_LENS = (131072, 196608, 262144, 393216, 524288)
+WARMUP_ITERS = 20
+REPLAY_ITERS = 100
+
+
+@cache_once
+def load_probe(cluster_size: int):
+    return load_jit(
+        f"topk_tdm_hist_probe_gfx1250_c{cluster_size}",
+        cuda_files=["deepseek_v4/topk_tdm_hist_probe.cuh"],
+        cuda_wrappers=[
+            (
+                "streaming",
+                "sglang::topk_tdm_probe::TopKTdmHistProbe::streaming",
+            ),
+            (
+                "cluster_tdm",
+                "sglang::topk_tdm_probe::TopKTdmHistProbe::cluster_tdm",
+            ),
+            (
+                "full_cluster_tdm",
+                "sglang::topk_tdm_probe::TopKTdmHistProbe::full_cluster_tdm",
+            ),
+        ],
+        extra_cuda_cflags=[
+            "-DSGL_ROCM_ARCH_GFX1250=1",
+            f"-DTOPK_TDM_PROBE_CLUSTER_SIZE={cluster_size}",
+        ],
+        extra_include_paths=["/sgl-workspace/aiter/csrc/include"],
+    )
+
+
+def benchmark_shape(batch_size: int, seq_len: int, cluster_size: int):
+    torch.manual_seed(batch_size * 100_003 + seq_len + cluster_size)
+    scores = torch.randn(
+        batch_size, seq_len, dtype=torch.float32, device="cuda"
+    )
+    seq_lens = torch.full(
+        (batch_size,), seq_len, dtype=torch.int32, device="cuda"
+    )
+    metadata = plan_topk_v2(seq_lens)
+    baseline = torch.empty(
+        batch_size, TOPK, dtype=torch.int32, device="cuda"
+    )
+    candidate = torch.empty_like(baseline)
+    histogram_scratch = torch.empty(
+        batch_size,
+        cluster_size,
+        HIST_SIZE,
+        dtype=torch.int32,
+        device="cuda",
+    )
+    count_scratch = torch.empty(
+        batch_size, cluster_size, 2, dtype=torch.int32, device="cuda"
+    )
+    tie_scratch = torch.empty(
+        batch_size, MAX_TIES, 2, dtype=torch.int32, device="cuda"
+    )
+    module = load_probe(cluster_size)
+
+    def streaming():
+        topk_transform_512_v2(
+            scores,
+            seq_lens,
+            None,
+            baseline,
+            PAGE_SIZE,
+            metadata,
+        )
+
+    def cluster_tdm():
+        module.full_cluster_tdm(
+            scores,
+            histogram_scratch,
+            count_scratch,
+            tie_scratch,
+            candidate,
+        )
+
+    streaming()
+    cluster_tdm()
+    torch.cuda.synchronize()
+
+    reference = torch.topk(scores, TOPK, dim=1, sorted=False).indices
+    for row, (ref, got_streaming, got_cluster) in enumerate(
+        zip(
+            reference.cpu().tolist(),
+            baseline.cpu().tolist(),
+            candidate.cpu().tolist(),
+        )
+    ):
+        ref_set = set(ref)
+        if set(got_streaming) != ref_set:
+            raise AssertionError(f"streaming mismatch in row {row}")
+        if set(got_cluster) != ref_set:
+            raise AssertionError(f"TDM cluster mismatch in row {row}")
+
+    common = {
+        "use_cuda_graph": False,
+        "warmup_iters": WARMUP_ITERS,
+        "replay_iters": REPLAY_ITERS,
+        "metrics": (0.5, "avg"),
+        "memory_args": (scores,),
+    }
+    streaming_times = marker.do_bench(streaming, **common).times
+    cluster_times = marker.do_bench(cluster_tdm, **common).times
+    return streaming_times, cluster_times
+
+
+def main():
+    props = torch.cuda.get_device_properties(torch.cuda.current_device())
+    print(f"device: {props.name} ({getattr(props, 'gcnArchName', 'unknown')})")
+    print(
+        f"correctness: exact output-set equality versus torch.topk; "
+        f"timing: {WARMUP_ITERS} warmups, {REPLAY_ITERS} GPU-event iterations"
+    )
+    print(
+        "| cluster | batch | C4 seq | streaming median us | TDM cluster median us | "
+        "streaming avg us | TDM cluster avg us | speedup |"
+    )
+    print("| ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |")
+    for seq_len in C4_SEQ_LENS:
+        for batch_size in BATCH_SIZES:
+            for cluster_size in CLUSTER_SIZES:
+                streaming_times, cluster_times = benchmark_shape(
+                    batch_size, seq_len, cluster_size
+                )
+                print(
+                    f"| {cluster_size} | {batch_size} | {seq_len} | "
+                    f"{streaming_times[0] * 1e6:.2f} | "
+                    f"{cluster_times[0] * 1e6:.2f} | "
+                    f"{streaming_times[1] * 1e6:.2f} | "
+                    f"{cluster_times[1] * 1e6:.2f} | "
+                    f"{streaming_times[0] / cluster_times[0]:.3f}x |"
+                )
+
+
+if __name__ == "__main__":
+    main()
